{
     "info": {
          "name": "PRive",
          "description": "Complete API documentation for PRive dating app backend",
          "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
     },
     "item": [
          {
               "name": "Users",
               "description": "User management endpoints",
               "item": [
                    {
                         "name": "Get Current User",
                         "description": "Returns the authenticated user's profile information",
                         "request": {
                              "method": "GET",
                              "url": "{{base_url}}/api/users/me",
                              "header": [
                                   {
                                        "key": "Authorization",
                                        "value": "Bearer {{token}}"
                                   }
                              ]
                         }
                    },
                    {
                         "name": "Update Current User",
                         "description": "Updates the authenticated user's information. All fields are optional.",
                         "request": {
                              "method": "PUT",
                              "url": "{{base_url}}/api/users/me",
                              "header": [
                                   {
                                        "key": "Authorization",
                                        "value": "Bearer {{token}}"
                                   }
                              ],
                              "body": {
                                   "mode": "raw",
                                   "raw": "{\n  \"name\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"phone\": \"+1234567890\",\n  \"age\": 28,\n  \"occupation\": \"Photographer\",\n  \"bio\": \"Love meeting new people\",\n  \"location\": \"New York, NY\",\n  \"work\": \"Freelance Photographer\",\n  \"education\": \"NYU\",\n  \"languages\": [\"English\", \"Spanish\"],\n  \"avatar\": \"https://example.com/avatar.jpg\",\n  \"coverImage\": \"https://example.com/cover.jpg\"\n}",
                                   "options": {
                                        "raw": {
                                             "language": "json"
                                        }
                                   }
                              }
                         }
                    },
                    {
                         "name": "Delete Current User",
                         "description": "Soft deletes the authenticated user's account",
                         "request": {
                              "method": "DELETE",
                              "url": "{{base_url}}/api/users/me",
                              "header": [
                                   {
                                        "key": "Authorization",
                                        "value": "Bearer {{token}}"
                                   }
                              ]
                         }
                    },
                    {
                         "name": "Get User By ID",
                         "description": "Returns a user's public profile by their ID",
                         "request": {
                              "method": "GET",
                              "url": "{{base_url}}/api/users/1",
                              "header": [
                                   {
                                        "key": "Authorization",
                                        "value": "Bearer {{token}}"
                                   }
                              ]
                         }
                    }
               ]
          },
